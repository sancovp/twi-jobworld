# Buyer instance config — cp env.example .env and fill. Non-secret knobs only.
# (Real keys go in secrets.env, not here.)

GHCR_OWNER=sancovp                 # the vendor's GHCR namespace (where the image lives)
INSTANCE_NAME=b6-outreach          # this instance's name
JW_CLIENT=b6                       # which baked client config to run

# The box's PUBLIC base URL for tracked links + the unsubscribe endpoint.
# Must be reachable 24/7 (a real domain/IP pointing at this box, port 8000).
# Empty => links go untracked (fine for a dry test, not for a live campaign).
HOST_BASE_URL=

# Auto-update poll interval (seconds). 3600 = hourly. Watchtower checks GHCR for
# a newer avi-jw:latest and recreates the instance when one appears.
UPDATE_INTERVAL=3600
