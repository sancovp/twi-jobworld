# Worker-layer secret bundle — one per client env_profile (client.json.env_profile).
# Copy to deploy/secrets.<profile>.env and fill. NEVER commit a filled copy
# (.gitignore blocks deploy/secrets*.env except this example).
#
# Which verbs need which vars: see connectors/outreach/README.md.

# --- CEO model backend (MiniMax) — the agent's LLM. NOT video. ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

# --- jwout video: pick the backend (fal_kling | minimax). Default fal_kling. ---
# Kling (via fal.ai) is the chosen tool. Real fal price ~$0.07-0.08/sec (~$0.4-0.8 per
# teaser) — ~2-3x the SPEC's ~3¢/sec estimate, but per-BRAND + amortized → trivial vs deal value.
# VIDEO_DRY_RUN=1 prints the request instead of generating. Confirm the model slug/tier
# on fal.ai before the first paid run. (video is OPTIONAL — text_only variant needs none.)
VIDEO_BACKEND=fal_kling
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/text-to-video
FAL_VIDEO_DURATION=10
# fallback only (VIDEO_BACKEND=minimax): MiniMax Hailuo — NOT the chosen tool
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-02
MINIMAX_VIDEO_DURATION=6
MINIMAX_VIDEO_RESOLUTION=1080P

# --- jwout pull + market (Apollo) ---
APOLLO_API_KEY=

# --- market cross-check (US Census CBP — FREE key: api.census.gov/data/key_signup.html) ---
CENSUS_API_KEY=
CENSUS_CBP_YEAR=2022

# --- jwout send: pick the backend (smtp | instantly). Default smtp. ---
SEND_BACKEND=instantly

# send backend A — SMTP (dumb relay; the hand-rolled R&D track, warmup UNPROVEN —
# see docs/WARMUP-RND.md). The warmed cold domain, NEVER the client primary domain.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_STARTTLS=1

# send backend B — Instantly (BASELINE; proven warmup + deliverability, ~$40/mo).
# Create ONE campaign whose step template is {{subject}} / {{body}}, put its id below.
# INSTANTLY_DRY_RUN=1 prints the lead payload instead of POSTing (sanity-check first).
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
INSTANTLY_DRY_RUN=

# --- jwout reply: pick the backend (imap | instantly). Defaults to SEND_BACKEND. ---
# With SEND_BACKEND=instantly, replies live in Instantly's Unibox (uses INSTANTLY_* above),
# so leave this unset. Set REPLY_BACKEND=imap only to read a separate monitored inbox.
REPLY_BACKEND=

# reply backend — IMAP (the monitored reply inbox)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SSL=1

# --- jwout host (the static server fronting the served dir) ---
HOST_DIR=/jobworld_data/hosted
HOST_BASE_URL=

# --- run state ---
JWOUT_DB=/jobworld_data/outreach.db
